ENV=development

# Local dev default; docker-compose overrides this to point at the `db` service.
DATABASE_URL=postgresql+psycopg2://pramaan:pramaan@localhost:5432/pramaan

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440

# Must base64-decode to exactly 32 bytes (AES-256-GCM key). Generate with:
# python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Dedicated key for HMAC-signing risk score records — deliberately separate
# from JWT_SECRET_KEY/ENCRYPTION_KEY. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
HMAC_SECRET_KEY=replace-with-a-long-random-secret

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://pramaanai-703j.onrender.com

# --- Modular document verification (/api/v1) ---
# Versioned reference data (checkpoints, border rules, templates, mock registries)
PRAMAAN_REFERENCE_DATA_DIR=reference_data
# YOLO11 region-detector weights. Empty = use models/yolo/pramaan_regions_yolo11n.pt
# if present; "none" = force the classical OpenCV detector.
PRAMAAN_YOLO_WEIGHTS=
PRAMAAN_YOLO_CONF=0.35
# "mock" = fictional synthetic registry; "disabled" = REGISTRY_NOT_AVAILABLE
PRAMAAN_DL_REGISTRY_MODE=mock
PRAMAAN_TRAVEL_REGISTRY_MODE=mock
# Optional vision-language reasoner (OpenAI-compatible chat endpoint, e.g. a
# self-hosted Qwen-VL). Advisory text only; never changes a check result.
PRAMAAN_VLM_BASE_URL=
PRAMAAN_VLM_MODEL=
PRAMAAN_VLM_API_KEY=
PRAMAAN_VLM_SEND_IMAGE=false
# ONNX Runtime threads per PP-OCR engine (0 = auto: half the cores, max 4)
PRAMAAN_OCR_THREADS=0
